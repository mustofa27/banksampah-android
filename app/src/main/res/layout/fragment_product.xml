<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.fragment.ProductFragment"
    android:background="@color/secondary_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/spacing_large">
        <ImageView
            android:id="@+id/cart_container"
            android:layout_width="@dimen/icon_action_size"
            android:layout_height="@dimen/icon_action_size"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_cart"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/title"
            app:layout_constraintBottom_toBottomOf="@id/subtitle"
            android:layout_marginRight="@dimen/spacing_large"
            app:tint="@color/neutral_6"/>
        <TextView
            android:id="@+id/indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@drawable/rounded_red"
            android:text="0"
            android:textSize="@dimen/text_size_very_small"
            android:paddingLeft="@dimen/spacing_cart"
            android:paddingRight="@dimen/spacing_cart"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/spacing_minus_medium"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/cart_container"
            app:layout_constraintRight_toRightOf="@id/cart_container" />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/cart_container"
            android:textColor="@color/primary_5"
            android:textStyle="bold"
            android:text="@string/catalog"
            android:textSize="@dimen/text_size_big"
            android:layout_marginLeft="@dimen/spacing_mxlarge"
            android:layout_marginRight="@dimen/spacing_mxlarge"
            android:layout_marginTop="@dimen/spacing_large"/>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/cart_container"
            android:textColor="@color/primary_4"
            android:textStyle="bold"
            android:text="@string/product_catalog"
            android:textSize="@dimen/text_size_small"
            android:layout_marginRight="@dimen/spacing_mxlarge"
            android:layout_marginLeft="@dimen/spacing_mxlarge"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:id="@+id/loading_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        app:layout_constraintBottom_toTopOf="@id/loading_next"/>

</androidx.constraintlayout.widget.ConstraintLayout>