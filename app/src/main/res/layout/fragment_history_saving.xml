<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/secondary_2">
    <HorizontalScrollView
        android:id="@+id/status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:layout_marginTop="@dimen/spacing_small">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_large"
            android:paddingLeft="@dimen/spacing_large"
            android:paddingRight="@dimen/spacing_large"
            android:background="@color/neutral_1">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/status_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/spacing_large"
                android:paddingRight="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium"
                android:background="@drawable/rounded_riwayat_status"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:gravity="center"
                android:layout_marginRight="@dimen/spacing_large">
                <TextView
                    android:id="@+id/txt_status_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:textColor="@color/riwayat_status_text_color"
                    app:layout_constraintRight_toRightOf="parent"
                    android:text="@string/status_semua"/>
                <ImageView
                    android:id="@+id/icon_1"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_check_active"
                    app:layout_constraintTop_toTopOf="@id/txt_status_1"
                    app:layout_constraintBottom_toBottomOf="@id/txt_status_1"
                    android:adjustViewBounds="true"
                    app:layout_constraintRight_toLeftOf="@id/txt_status_1"
                    android:layout_marginRight="@dimen/spacing_medium"
                    android:visibility="gone"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/status_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/spacing_large"
                android:paddingRight="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium"
                android:background="@drawable/rounded_riwayat_status"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:gravity="center"
                android:layout_marginRight="@dimen/spacing_large">
                <TextView
                    android:id="@+id/txt_status_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:textColor="@color/riwayat_status_text_color"
                    app:layout_constraintRight_toRightOf="parent"
                    android:text="@string/status_0_saving"/>
                <ImageView
                    android:id="@+id/icon_2"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_check_active"
                    app:layout_constraintTop_toTopOf="@id/txt_status_2"
                    app:layout_constraintBottom_toBottomOf="@id/txt_status_2"
                    android:adjustViewBounds="true"
                    app:layout_constraintRight_toLeftOf="@id/txt_status_2"
                    android:layout_marginRight="@dimen/spacing_medium"
                    android:visibility="gone"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/status_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/spacing_large"
                android:paddingRight="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium"
                android:background="@drawable/rounded_riwayat_status"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:gravity="center"
                android:layout_marginRight="@dimen/spacing_large">
                <TextView
                    android:id="@+id/txt_status_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:textColor="@color/riwayat_status_text_color"
                    app:layout_constraintRight_toRightOf="parent"
                    android:text="@string/status_1_saving"/>
                <ImageView
                    android:id="@+id/icon_3"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_check_active"
                    app:layout_constraintTop_toTopOf="@id/txt_status_3"
                    app:layout_constraintBottom_toBottomOf="@id/txt_status_3"
                    android:adjustViewBounds="true"
                    app:layout_constraintRight_toLeftOf="@id/txt_status_3"
                    android:layout_marginRight="@dimen/spacing_medium"
                    android:visibility="gone"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/status_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/spacing_large"
                android:paddingRight="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium"
                android:background="@drawable/rounded_riwayat_status"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:gravity="center"
                android:layout_marginRight="@dimen/spacing_large">
                <TextView
                    android:id="@+id/txt_status_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:textColor="@color/riwayat_status_text_color"
                    app:layout_constraintRight_toRightOf="parent"
                    android:text="@string/status_2_saving"/>
                <ImageView
                    android:id="@+id/icon_4"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_check_active"
                    app:layout_constraintTop_toTopOf="@id/txt_status_4"
                    app:layout_constraintBottom_toBottomOf="@id/txt_status_4"
                    android:adjustViewBounds="true"
                    app:layout_constraintRight_toLeftOf="@id/txt_status_4"
                    android:layout_marginRight="@dimen/spacing_medium"
                    android:visibility="gone"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </HorizontalScrollView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/status_container"
        app:layout_constraintBottom_toBottomOf="parent">
        <ProgressBar
            android:id="@+id/loading_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/loading_next"
            android:padding="@dimen/spacing_large"
            android:background="@color/neutral_1" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>