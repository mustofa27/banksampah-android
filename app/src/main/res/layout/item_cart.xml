<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/spacing_medium"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/background_new">
    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/checkbox"
        android:layout_marginLeft="@dimen/spacing_medium">
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/checkbox"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginLeft="@dimen/spacing_medium"
        android:layout_marginRight="@dimen/spacing_medium">
        <ImageView
            android:id="@+id/imageview"
            android:layout_width="@dimen/im_product_size"
            android:layout_height="@dimen/im_product_size"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_loader"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:id="@+id/product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/neutral_6"
            android:textSize="@dimen/text_size"
            app:layout_constraintLeft_toRightOf="@id/imageview"
            app:layout_constraintTop_toTopOf="parent"
            android:textStyle="bold"
            android:text="Nama Produk"
            android:maxLines="2"
            android:lines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/spacing_xmedium"
            android:layout_marginLeft="@dimen/spacing_large"/>
        <TextView
            android:id="@+id/product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/neutral_6"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintLeft_toRightOf="@id/imageview"
            app:layout_constraintTop_toBottomOf="@id/product_name"
            android:text="Rp 320.000,-"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginLeft="@dimen/spacing_large"/>
        <TextView
            android:id="@+id/product_price_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintLeft_toRightOf="@id/imageview"
            app:layout_constraintTop_toBottomOf="@id/product_price"
            android:text="Rp 320.000,-"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginLeft="@dimen/spacing_large"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_jumlah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/border_neutral_300_neutral_200"
            android:layout_weight="4"
            android:layout_marginRight="@dimen/spacing_medium"
            app:layout_constraintLeft_toRightOf="@id/imageview"
            app:layout_constraintTop_toBottomOf="@id/product_price_discount"
            app:layout_constraintWidth_percent="0.4"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginLeft="@dimen/spacing_large">
            <TextView
                android:id="@+id/minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/neutral_4"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:padding="@dimen/spacing_medium"
                android:text="-"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:layout_marginLeft="@dimen/spacing_middle"/>
            <TextView
                android:id="@+id/plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/neutral_4"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:padding="@dimen/spacing_medium"
                android:text="+"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:layout_marginRight="@dimen/spacing_middle" />
            <EditText
                android:id="@+id/jumlah"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:textColor="@color/neutral_6"
                android:textStyle="bold"
                android:inputType="number"
                android:text="0"
                android:textSize="@dimen/text_size_medium"
                android:gravity="center"
                android:background="@drawable/border_neutral_300_neutral_100"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/minus"
                app:layout_constraintRight_toLeftOf="@id/plus"
                android:layout_marginLeft="@dimen/spacing_medium"
                android:layout_marginRight="@dimen/spacing_medium" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/pembatas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_xxsmall"
        app:layout_constraintTop_toBottomOf="@id/container_right"
        android:background="@color/neutral_3"
        android:layout_marginTop="@dimen/spacing_medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>